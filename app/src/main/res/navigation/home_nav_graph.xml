<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/HomeFragment">

    <fragment
        android:id="@+id/HomeFragment"
        android:name="mrkinfotech.fitkart.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_first" />

    <activity
        android:id="@+id/productDetailActivity"
        android:name="mrkinfotech.fitkart.ui.details.ProductDetailsActivity"
        android:label="Product Details"
        tools:layout="@layout/activity_product_details" />

    <fragment
        android:id="@+id/CartFragment"
        android:name="mrkinfotech.fitkart.ui.cart.CartFragment"
        android:label="Cart"
        tools:layout="@layout/fragment_cart">
        <action
            android:id="@+id/action_CartFragment_to_OrderSuccessFragment"
            app:destination="@id/OrderSuccessFragment" />
    </fragment>

    <fragment
        android:id="@+id/OrderSuccessFragment"
        android:name="mrkinfotech.fitkart.ui.cart.OrderSuccessFragment"
        android:label="Order Placed"
        tools:layout="@layout/fragment_order_success">
        <action
            android:id="@+id/action_OrderSuccessFragment_to_BillFragment"
            app:destination="@id/BillFragment"
            app:popUpTo="@id/CartFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/BillFragment"
        android:name="mrkinfotech.fitkart.ui.cart.BillFragment"
        android:label="Invoice"
        tools:layout="@layout/fragment_bill" />

    <fragment
        android:id="@+id/LikeFragment"
        android:name="mrkinfotech.fitkart.ui.like.LikeFragment"
        android:label="Wishlist"
        tools:layout="@layout/fragment_like" />

    <fragment
        android:id="@+id/AccountFragment"
        android:name="mrkinfotech.fitkart.ui.account.AccountFragment"
        android:label="Account"
        tools:layout="@layout/fragment_account">
        <action
            android:id="@+id/action_AccountFragment_to_OrdersFragment"
            app:destination="@id/OrdersFragment" />
    </fragment>

    <fragment
        android:id="@+id/OrdersFragment"
        android:name="mrkinfotech.fitkart.ui.account.OrdersFragment"
        android:label="My Orders"
        tools:layout="@layout/fragment_orders">
        <action
            android:id="@+id/action_OrdersFragment_to_OrderDetailFragment"
            app:destination="@id/OrderDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/OrderDetailFragment"
        android:name="mrkinfotech.fitkart.ui.account.OrderDetailFragment"
        android:label="Order Summary"
        tools:layout="@layout/fragment_order_details" />

</navigation>